PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
FRONTEND_URL="http://localhost:5173"
TRUSTED_PROXIES=

# Optional: Google sign-in and email delivery
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional: required for private project attachment uploads
CLOUDMERSIVE_API_KEY=

# Matching falls back to deterministic rules when provider credentials are absent
MATCHING_POLL_MS=3000
MATCH_LLM_API_KEY=
MATCH_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MATCH_LLM_MODEL=gemini-3.8-flash
MATCH_LLM_ENABLED=true
MATCH_LLM_TIMEOUT_MS=20000
MATCH_EMBED_API_KEY=
MATCH_EMBED_BASE_URL=
MATCH_EMBED_MODEL=gemini-embedding-001
MATCH_EMBED_DIMENSIONS=256
MATCH_EMBED_ENABLED=true
MATCH_EMBED_TIMEOUT_MS=20000
MATCH_EMBED_MIN_SIM=0.55
MATCH_EMBED_FULL_SIM=0.75

# Optional: defaults to 50 notifications per user per day
NOTIFICATIONS_DAILY_LIMIT=50
