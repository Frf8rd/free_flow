PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
FRONTEND_URL="http://localhost:5173"
TRUSTED_PROXIES=
GOOGLE_CLIENT_ID=
MATCHING_QUEUE=pgboss
MATCHING_WORKER_CONCURRENCY=4
MATCHING_POLL_SECONDS=5
MATCH_LLM_PROVIDER=openai-compatible
MATCH_LLM_API_KEY=
MATCH_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MATCH_LLM_MODEL=gemini-3.8-flash
MATCH_LLM_ENABLED=true
MATCH_LLM_CONCURRENCY=4
MATCH_EMBED_MODEL=gemini-embedding-001
MATCH_EMBED_DIMENSIONS=256
MATCH_EMBED_MIN_SIM=0.55
MATCH_EMBED_FULL_SIM=0.75
