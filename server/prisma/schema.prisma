generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}

enum AuthProvider {
  GOOGLE
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum Level {
  BEGINNER
  JUNIOR
  MID
  SENIOR
}

enum Availability {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum Tier {
  START
  VERIFIED
  PROVEN
  EXPERT
}

enum MatchStatus {
  SUGGESTED
  FREELANCER_INTERESTED
  CLIENT_INVITED
  ACCEPTED
  DISMISSED
}

enum MatchingStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum RecommendationSide {
  CLIENT
  FREELANCER
}

enum MatchingJobType {
  PROJECT
  FREELANCER
}

enum AccountTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ReportTargetType {
  USER
  PROJECT
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String
  role            Role
  avatarUrl       String?
  isBlocked       Boolean   @default(false)
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  adminAccess               Admin?
  freelancerProfile         FreelancerProfile?
  clientProfile             ClientProfile?
  refreshTokens             RefreshToken[]
  oauthAccounts             OAuthAccount[]
  projects                  Project[]
  accountTokens             AccountToken[]
  submittedReports          Report[]                   @relation("ReportReporter")
  resolvedReports           Report[]                   @relation("ReportResolver")
  clientEngagements         Engagement[]               @relation("EngagementClient")
  freelancerEngagements     Engagement[]               @relation("EngagementFreelancer")
  clientConversations       Conversation[]             @relation("ConversationClient")
  freelancerConversations   Conversation[]             @relation("ConversationFreelancer")
  sentMessages              Message[]
  projectAttachments        ProjectAttachment[]
  reviewsWritten            Review[]                   @relation("ReviewAuthor")
  reviewsReceived           Review[]                   @relation("ReviewTarget")
  notifications             Notification[]
  recommendationImpressions RecommendationImpression[] @relation("RecommendationViewer")
}

model Admin {
  email     String   @id
  createdAt DateTime @default(now())
  user      User     @relation(fields: [email], references: [email], onDelete: Cascade, onUpdate: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model OAuthAccount {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model OAuthChallenge {
  id         String       @id @default(cuid())
  provider   AuthProvider
  nonceHash  String       @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([provider, expiresAt])
}

model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  skills   Skill[]
  projects Project[]
}

model Skill {
  id         String   @id @default(cuid())
  name       String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  projects    ProjectSkill[]
  freelancers FreelancerSkill[]
}

model FreelancerProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String       @default("")
  bio            String       @default("")
  level          Level        @default(BEGINNER)
  hourlyRate     Int?
  availability   Availability @default(AVAILABLE)
  languages      String[]     @default([])
  onboarded      Boolean      @default(false)
  tier           Tier         @default(START)
  completedCount Int          @default(0)
  matchedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  skills                    FreelancerSkill[]
  portfolio                 PortfolioItem[]
  matches                   Match[]
  recommendationImpressions RecommendationImpression[]

  @@index([availability, hourlyRate])
}

model ClientProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("PERSON")
  onboarded   Boolean  @default(false)
  companyName String?
  description String?
  industry    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FreelancerSkill {
  freelancerId String
  skillId      String
  level        Level             @default(BEGINNER)
  verified     Boolean           @default(false)
  freelancer   FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  skill        Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([freelancerId, skillId])
  @@index([skillId])
}

model Project {
  id             String         @id @default(cuid())
  clientId       String
  client         User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  description    String
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  budgetMin      Int?
  budgetMax      Int?
  deadline       DateTime?
  status         ProjectStatus  @default(OPEN)
  isStarter      Boolean        @default(false)
  matchingStatus MatchingStatus @default(PENDING)
  matchingError  String?
  matchedAt      DateTime?
  extracted      Json?
  embedding      Float[]        @default([])
  embeddingModel String?
  embeddingHash  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  skills                    ProjectSkill[]
  engagements               Engagement[]
  attachments               ProjectAttachment[]
  conversations             Conversation[]
  matches                   Match[]
  recommendationImpressions RecommendationImpression[]

  @@index([status, categoryId])
  @@index([status, matchingStatus])
}

enum EngagementStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  COMPLETED
  REJECTED
  CANCELLED
}

model Engagement {
  id           String           @id @default(cuid())
  matchId      String?          @unique
  match        Match?           @relation(fields: [matchId], references: [id], onDelete: SetNull)
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId     String
  client       User             @relation("EngagementClient", fields: [clientId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User             @relation("EngagementFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)
  status       EngagementStatus @default(PENDING)
  agreedPrice  Int?
  deadline     DateTime?
  usedAi       Boolean?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deliveredAt  DateTime?
  completedAt  DateTime?
  rejectedAt   DateTime?
  cancelledAt  DateTime?
  conversation Conversation?
  reviews      Review[]

  @@unique([projectId, freelancerId])
  @@index([clientId, status, createdAt])
  @@index([freelancerId, createdAt])
}

model Conversation {
  id           String      @id @default(cuid())
  engagementId String?     @unique
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  matchId      String?     @unique
  match        Match?      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId     String
  client       User        @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Cascade)
  freelancerId String
  freelancer   User        @relation("ConversationFreelancer", fields: [freelancerId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  messages     Message[]

  @@index([clientId, updatedAt])
  @@index([freelancerId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt, id])
  @@index([conversationId, readAt])
}

model ProjectSkill {
  projectId String
  skillId   String
  source    String  @default("USER")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model ProjectAttachment {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  originalName String
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
}

model AccountToken {
  id         String              @id @default(cuid())
  tokenHash  String              @unique
  purpose    AccountTokenPurpose
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([userId, purpose, expiresAt])
}

model PendingRegistration {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  reporter     User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType
  targetId     String
  reason       String
  details      String?
  status       ReportStatus     @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedBy   User?            @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model Review {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId     String
  target       User       @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([engagementId, authorId])
  @@index([targetId, createdAt])
}

model PortfolioItem {
  id             String            @id @default(cuid())
  profileId      String
  profile        FreelancerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  imageUrl       String?
  link           String?
  embedding      Float[]           @default([])
  embeddingModel String?
  embeddingHash  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([profileId, createdAt])
}

model Match {
  id             String            @id @default(cuid())
  projectId      String
  freelancerId   String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer     FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  score          Float
  reasons        Json
  status         MatchStatus       @default(SUGGESTED)
  dismissReason  String?
  projectRank    Int?
  freelancerRank Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  engagement     Engagement?
  conversation   Conversation?

  @@unique([projectId, freelancerId])
  @@index([freelancerId, status])
  @@index([projectId, score])
  @@index([projectId, projectRank])
  @@index([freelancerId, freelancerRank])
}

model RecommendationImpression {
  id           String             @id @default(cuid())
  projectId    String
  freelancerId String
  viewerUserId String
  side         RecommendationSide
  rank         Int
  slotType     String             @default("STANDARD")
  day          DateTime           @db.Date
  shownAt      DateTime           @default(now())
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer   FreelancerProfile  @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  viewer       User               @relation("RecommendationViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@unique([projectId, freelancerId, viewerUserId, side, day])
  @@index([freelancerId, side, shownAt])
  @@index([projectId, side, shownAt])
}

model MatchingJob {
  id        String          @id @default(cuid())
  type      MatchingJobType
  targetId  String
  revision  Int             @default(0)
  attempts  Int             @default(0)
  nextRunAt DateTime        @default(now())
  lockedAt  DateTime?
  lastError String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([type, targetId])
  @@index([nextRunAt, lockedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @default("")
  data      Json?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([userId, dedupeKey])
}
